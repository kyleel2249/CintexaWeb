# Server
PORT=8080
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cintexa

# Clerk (https://clerk.com) — legacy / optional
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_API_BASE_URL=http://localhost:8080/api

# Firebase (client — set the same names as Cloudflare Pages env / secrets)
# Required for app init: API_KEY, PROJECT_ID, APP_ID
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Security
ADMIN_API_KEY=change-me-to-a-long-random-string
WEBHOOK_SECRET=change-me-to-another-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Measurement pixels — each loads ONLY after the visitor opts in via the cookie banner, and only if its ID is set.
# Leave blank to disable. G-… tags need "Analytics" consent; AW-…, Meta and LinkedIn need "Advertising & marketing".
VITE_META_PIXEL_ID=
VITE_LINKEDIN_PARTNER_ID=
VITE_GOOGLE_TAG_ID=

# API server: number of reverse-proxy hops to trust for client IPs (rate limiting). 0 when exposed directly.
TRUST_PROXY=1
