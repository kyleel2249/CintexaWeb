{
  "name": "cintexa-growth-platform",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev:web": "npm run dev -w cintexa",
    "dev:api": "npm run dev -w api-server",
    "build": "npm run build -w api-server && npm run build -w cintexa",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
